# Copy to dev.env and fill in real values (dev.env is gitignored).

# Database (optional — use KEY=value syntax)
# DB_HOST=your-host
# DB_PORT=5432
# DB_USER=postgres
# DB_NAME=zucora-horizon-dev
# DB_PASSWORD=your-secret

# Admin UI
BASE_URL=https://dev.horizon.ths.agency

# API (optional — falls back in api-config if unset)
# API_BASE_URI=https://api.dev.example.com/api/v1

# Test accounts
PATIENT_EMAIL=your-user@example.com
VALID_PASSWORD=your-password
