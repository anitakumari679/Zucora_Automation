# Copy to stage.env and fill in real values (stage.env is gitignored).

# Database (optional — use KEY=value syntax)
# DB_HOST=your-host
# DB_PORT=5433
# DB_USER=postgres
# DB_NAME=zucora-horizon-stage
# DB_PASSWORD=your-secret

# Admin UI
BASE_URL=https://stage.horizon.ths.agency

# API (optional)
# API_BASE_URI=https://api.stage.example.com/api/v1

# Test accounts
PATIENT_EMAIL=your-user@example.com
VALID_PASSWORD=your-password
